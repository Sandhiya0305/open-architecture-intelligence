{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oai:claim:v1",
  "title": "Source-linked architecture claim candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "observation_id",
    "source_url",
    "source_title",
    "source_id",
    "source_record_id",
    "source_type",
    "architecture_ids",
    "claim_text",
    "claim_kinds",
    "evidence_status",
    "review_status",
    "extraction_method",
    "review_note",
    "normalized_claim",
    "duplicate_observation_ids",
    "possible_conflict_observation_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "article"
      ]
    },
    "architecture_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "claim_text": {
      "type": "string",
      "minLength": 45,
      "maxLength": 600
    },
    "claim_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "benefit",
          "decision",
          "limitation",
          "performance"
        ]
      }
    },
    "evidence_status": {
      "const": "unverified"
    },
    "review_status": {
      "enum": [
        "pending",
        "approve",
        "reject",
        "needs-evidence"
      ]
    },
    "extraction_method": {
      "const": "architecture_sentence_rules_v3"
    },
    "review_note": {
      "type": "string"
    },
    "normalized_claim": {
      "type": "string",
      "minLength": 1
    },
    "duplicate_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "possible_conflict_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "publisher_type": {
      "enum": [
        "editorial",
        "practitioner",
        "vendor",
        "research",
        "community",
        "unspecified"
      ]
    }
  }
}
