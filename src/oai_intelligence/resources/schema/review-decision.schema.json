{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oai:review-decision:v1",
  "title": "Authenticated human claim review decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "claim_id",
    "decision",
    "reviewer",
    "reviewer_id",
    "source_checked",
    "reviewed_source_url",
    "note",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_id": {
      "type": "string",
      "format": "uuid"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "needs-evidence"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_id": {
      "type": "integer",
      "minimum": 1
    },
    "source_checked": {
      "const": true
    },
    "reviewed_source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
